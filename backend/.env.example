# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string
# Example format: mongodb+srv://<username>:<password>@<cluster-url>/resqconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resqconnect?retryWrites=true&w=majority

# JWT Authentication
# Generate a strong, secure random string for production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=7d

# Cookie Security (for signed cookies)
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret

# Allowed Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
